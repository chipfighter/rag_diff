# Copy this file to .env and fill in your key. .env is gitignored.
# Both rag-diff's judge and the example RAG pipeline read these variables.
# Any OpenAI-compatible API works -- just change the key, base URL, and model.

# DeepSeek (default for the example):
OPENAI_API_KEY=your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com

# For OpenAI instead:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
